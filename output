 set -euo pipefail
  test -n "${GROQ_API_KEY:-}"
  STATE_DIR="${RUNNER_TEMP}/aihome-weather-state"
  RUNTIME_CONFIG="${RUNNER_TEMP}/aihome-weather-config"
  mkdir -p "${STATE_DIR}" "${RUNTIME_CONFIG}"
  GATEWAY_TOKEN="$(openssl rand -hex 32)"
  printf '%s\n' "GATEWAY_TOKEN" > /dev/null
  printf '::add-mask::%s\n' "${GATEWAY_TOKEN}"
  echo "OPENCLAW_GATEWAY_TOKEN=${GATEWAY_TOKEN}" >> "${GITHUB_ENV}"
  docker rm -f aihome-openclaw-weather-test >/dev/null 2>&1 || true
  docker run -d \
    --name aihome-openclaw-weather-test \
    --memory 4g \
    --memory-swap 8g \
    --cpus 1.50 \
    --pids-limit 256 \
    --security-opt no-new-privileges:true \
    --cap-drop ALL \
    -e TZ=Asia/Ho_Chi_Minh \
    -e OPENCLAW_HOME=/data/state \
    -e OPENCLAW_STATE_DIR=/data/state \
    -e OPENCLAW_CONFIG_PATH=/data/config/openclaw.json5 \
    -e OPENCLAW_GATEWAY_TOKEN="${GATEWAY_TOKEN}" \
    -e GROQ_API_KEY="${GROQ_API_KEY}" \
    -e OPENCLAW_PLUGIN_LOAD_DEBUG=1 \
    -v "${STATE_DIR}:/data/state" \
    -v "${RUNTIME_CONFIG}:/data/config" \
    -v "${GITHUB_WORKSPACE}/config/openclaw/openclaw.json5:/data/source-config/openclaw.json5:ro" \
    -v "${GITHUB_WORKSPACE}/config/aihome:/home/node/.openclaw/workspace/config/aihome:ro" \
    -v "${GITHUB_WORKSPACE}/skills/weather:/home/node/.openclaw/workspace/skills/weather:ro" \
    "${OPENCLAW_IMAGE}" \
    sh -lc 'set -eu; cp /data/source-config/openclaw.json5 /data/config/openclaw.json5; set +e; update_output="$$(node openclaw.mjs plugins update npm:@openclaw/groq-provider@2026.8.2 2>&1)"; update_rc=$$?; set -e; printf "%s\\n" "$$update_output"; if [ "$$update_rc" -ne 0 ]; then if printf "%s\\n" "$$update_output" | grep -Fq "No tracked plugin or hook pack found"; then node openclaw.mjs plugins install npm:@openclaw/groq-provider@2026.8.2 --force --pin; else exit "$$update_rc"; fi; fi; node openclaw.mjs plugins enable groq; exec node openclaw.mjs gateway run' >/tmp/aihome-weather-openclaw.log 2>&1
  
  for i in $(seq 1 24); do
    if docker exec -e OPENCLAW_GATEWAY_TOKEN="${GATEWAY_TOKEN}" aihome-openclaw-weather-test node openclaw.mjs gateway status --require-rpc >/tmp/aihome-weather-gateway-status 2>&1; then
      cat /tmp/aihome-weather-gateway-status
      echo 'OPENCLAW_GATEWAY=PASS'
      exit 0
    fi
    sleep 5
  done
  echo 'OPENCLAW_GATEWAY=FAIL'
  cat /tmp/aihome-weather-openclaw.log || true
  docker logs --tail 300 aihome-openclaw-weather-test || true
  exit 1
