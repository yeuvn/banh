echo '=== 1. SYMLINK / DIRECTORY ==='
for p in \
  source/workspace \
  openclaw/workspace \
  openclaw/state/workspace \
  openclaw/state/.openclaw/workspace
do
  echo "--- $p ---"
  stat -c 'type=%F inode=%i mode=%A owner=%U:%G' "$p" 2>/dev/null || true
  readlink -f "$p" 2>/dev/null || true
done

echo
echo '=== 2. ALL FILES IN FOUR WORKSPACES ==='
for p in \
  source/workspace \
  openclaw/workspace \
  openclaw/state/workspace \
  openclaw/state/.openclaw/workspace
do
  echo "--- $p ---"
  find "$p" -type f -printf '%P\n' 2>/dev/null | sort
done

echo
echo '=== 3. DOCKER MOUNTS ==='
docker inspect aihome-openclaw-test \
  --format '{{range .Mounts}}{{println .Type .Source "->" .Destination}}{{end}}' | sort

