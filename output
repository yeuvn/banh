git reflog -12 --date=iso > "$BACKUP/git-reflog.txt"

# 4. Xác nhận backup tồn tại
echo "========== BACKUP =========="
echo "$BACKUP"
du -sh "$BACKUP"

# 5. Quay về branch Test
git fetch origin Test
git checkout Test

