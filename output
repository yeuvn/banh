aihome@AIHome:~$ cd /opt/aihome

# 1. Tạo thư mục backup ngoài Git
BACKUP="/opt/aihome-rollback-backup-$(date +%Y%m%d-%H%M%S)"
mkdir -p "$BACKUP"

# 2. Sao lưu toàn bộ các mục đang untracked
for x in .docker compose/.env compose/backup config data output; do
    if [ -e "$x" ]; then
        mkdir -p "$BACKUP/$(dirname "$x")"
        cp -a "$x" "$BACKUP/$x"
    fi
done

# 3. Ghi lại trạng thái Git hiện tại
git status --short --branch > "$BACKUP/git-status.txt"
